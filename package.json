{
  "scripts": {
    "dev": "nodemon",
    "build": "rm -rf build && tsc -b && tsc-alias",
    "start": "node build/index.js",
    "prettier": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d ./src/data-source.ts",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d ./src/data-source.ts",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d ./src/data-source.ts"
  },
  "dependencies": {
    "@apollo/client": "3",
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphql": "^16.12.0",
    "graphql-scalars": "^2.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.14",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "tsc": "^2.0.4",
    "tsx": "^4.23.12",
    "type-graphql": "^2.0.0-rc.3",
    "typeorm": "^1.1.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "jest": "^30.4.2",
    "prettier": "3.9.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.4"
  }
}
